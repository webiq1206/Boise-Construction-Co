# Copy to .env.local for local dev and builds (see .env.local in repo for defaults)

# Required for admin sessions & quote edit tokens (32+ characters)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional — marketing pages work without it (in-memory fallback for quotes/gallery)
# DATABASE_URL=postgresql://...

# Admin access. The authoritative allowlist for OIDC login lives in lib/auth.ts
# (ADMIN_EMAILS); server/storage.ts reads this env var on its own user-upsert
# path. Keep the two in sync so role assignment cannot disagree between paths.
# Comma-separated, lowercase.
# ADMIN_EMAILS=webiq.co@gmail.com,info@webiq.co,hello@boiseconstruction.co,hello@boisecabinet.co,hello@p5homeco.com

# Public site (override before launch)
# NEXT_PUBLIC_SITE_URL=https://boiseconstruction.co
# NEXT_PUBLIC_PHONE=(208) 477-1169
# NEXT_PUBLIC_PHONE_TEL=2084771169
# NEXT_PUBLIC_EMAIL=hello@boiseconstruction.co
# GA4 "Boise Construction Co" property. The code already defaults to this ID,
# so setting it here is only needed to point a staging build at a different
# property. Do NOT set it to G-NGE449QF9Y - that is Boise Remodeling Co.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-VTVTQZ8JCD

# Microsoft Clarity project for boiseconstruction.co (heatmaps + session
# recordings). The code already defaults to this, so set it only to point a
# staging build elsewhere. Do NOT set it to x5wrjdadlb - that is
# boiseremodeling.co.
# NEXT_PUBLIC_CLARITY_PROJECT_ID=y1sf0nz948
# Meta dataset "Boise Construction Co". The code already defaults to this, so
# set it only to point a staging build elsewhere. Do NOT set it to
# 2461987544292871 - that is Boise Remodeling Co.
#
# If this changes, META_CAPI_ACCESS_TOKEN below MUST be reissued for the new
# dataset. The token is dataset-scoped, so a mismatch sends browser events to
# one dataset and server events to another and deduplication stops working.
# NEXT_PUBLIC_META_PIXEL_ID=925837669911613

# Meta Conversions API (server-side, deduplicated with the Pixel via event_id).
# In Events Manager > your dataset > Settings > Conversions API, generate an
# access token, then add it to Replit Secrets (server-only, NOT NEXT_PUBLIC).
# META_CAPI_ACCESS_TOKEN=
# Optional: dataset id override (defaults to NEXT_PUBLIC_META_PIXEL_ID).
# META_DATASET_ID=
# Optional: while testing, paste the code from Events Manager > Test Events to
# route server events to the Test Events tab. Remove/leave blank for live.
# META_CAPI_TEST_EVENT_CODE=

# RE-10 document analysis. Reads the uploaded RE-10 / inspection pages and
# returns the repair list. WITHOUT THIS KEY /api/re10/analyze answers 503 and
# the wizard offers the send-it-to-us-by-hand path instead - the page still
# works, it just cannot read a document automatically.
#
# Get one at https://console.anthropic.com > API keys. Server-only, NOT
# NEXT_PUBLIC: a NEXT_PUBLIC_ prefix would ship the key to every browser.
# Local: add the line below to .env.local (gitignored).
# Production: Replit > Secrets, then redeploy so the deployment picks it up.
# After setting it, `npm run check:re10-extraction` proves it end to end.
# ANTHROPIC_API_KEY=sk-ant-...

# Email (consultation notifications)
# RESEND_API_KEY=

# Address autocomplete (Google Places) — recommended for production
# Without this key, the form falls back to OpenStreetMap Nominatim (Treasure Valley only)
# GOOGLE_MAPS_API_KEY=

# Google Business Profile (set after verification)
# NEXT_PUBLIC_GBP_URL=https://maps.app.goo.gl/your-listing-short-link
# NEXT_PUBLIC_GBP_REVIEW_URL=https://g.page/r/your-review-short-link/review

# Parallel listings — append to schema sameAs when live
# NEXT_PUBLIC_BING_PLACES_URL=
# NEXT_PUBLIC_APPLE_BUSINESS_URL=
# NEXT_PUBLIC_YELP_URL=
# NEXT_PUBLIC_HOUZZ_URL=

# Lead dashboard linked from the admin lead emails ("View in lead dashboard").
# Defaults to https://leads.boiseremodeling.co (the shared lead dashboard stays
# on the original domain); override on staging so staff are not sent to production
# leads.
# NEXT_PUBLIC_LEADS_DASHBOARD_URL=https://leads.boiseremodeling.co

# Lead dashboard / CRM forwarding. WITHOUT THIS KEY forwardToLeadDashboard()
# returns immediately and no lead reaches the CRM at all, silently. Set it in
# Replit Secrets (server-only, NOT NEXT_PUBLIC).
# LEAD_DASHBOARD_KEY=

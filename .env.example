# Copy to .env.local for local dev and builds (see .env.local in repo for defaults)

# Required for admin sessions & quote edit tokens (32+ characters)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional — marketing pages work without it (in-memory fallback for quotes/gallery)
# DATABASE_URL=postgresql://...

# Admin access. The authoritative allowlist for OIDC login lives in lib/auth.ts
# (ADMIN_EMAILS); server/storage.ts reads this env var on its own user-upsert
# path. Keep the two in sync so role assignment cannot disagree between paths.
# Comma-separated, lowercase.
# ADMIN_EMAILS=webiq.co@gmail.com,info@webiq.co,hello@boiseremodeling.co,hello@boisecabinet.co,hello@p5homeco.com

# Public site (override before launch)
# NEXT_PUBLIC_SITE_URL=https://boiseremodeling.co
# NEXT_PUBLIC_PHONE=(208) 477-1169
# NEXT_PUBLIC_PHONE_TEL=2084771169
# NEXT_PUBLIC_EMAIL=hello@boiseremodeling.co
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-1HD7RT8PKJ
# Meta (Facebook) Pixel dataset ID. Create the dataset in Meta Events Manager,
# then paste its numeric ID here. Only loads in production; fires PageView on
# every page and a standard Lead event when a visitor completes the estimator.
# NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side, deduplicated with the Pixel via event_id).
# In Events Manager > your dataset > Settings > Conversions API, generate an
# access token, then add it to Replit Secrets (server-only, NOT NEXT_PUBLIC).
# META_CAPI_ACCESS_TOKEN=
# Optional: dataset id override (defaults to NEXT_PUBLIC_META_PIXEL_ID).
# META_DATASET_ID=
# Optional: while testing, paste the code from Events Manager > Test Events to
# route server events to the Test Events tab. Remove/leave blank for live.
# META_CAPI_TEST_EVENT_CODE=

# Email (consultation notifications)
# RESEND_API_KEY=

# Address autocomplete (Google Places) — recommended for production
# Without this key, the form falls back to OpenStreetMap Nominatim (Treasure Valley only)
# GOOGLE_MAPS_API_KEY=

# Google Business Profile (set after verification)
# NEXT_PUBLIC_GBP_URL=https://maps.app.goo.gl/your-listing-short-link
# NEXT_PUBLIC_GBP_REVIEW_URL=https://g.page/r/your-review-short-link/review

# Parallel listings — append to schema sameAs when live
# NEXT_PUBLIC_BING_PLACES_URL=
# NEXT_PUBLIC_APPLE_BUSINESS_URL=
# NEXT_PUBLIC_YELP_URL=
# NEXT_PUBLIC_HOUZZ_URL=

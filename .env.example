# Copy to .env.local for local dev and builds (see .env.local in repo for defaults)

# Required for admin sessions & quote edit tokens (32+ characters)
SESSION_SECRET=change-me-to-a-random-string-at-least-32-chars

# Optional — marketing pages work without it (in-memory fallback for quotes/gallery)
# DATABASE_URL=postgresql://...

# Public site (override before launch)
# NEXT_PUBLIC_SITE_URL=https://boiseremodeling.co
# NEXT_PUBLIC_PHONE=(208) 477-1169
# NEXT_PUBLIC_PHONE_TEL=2084771169
# NEXT_PUBLIC_EMAIL=hello@boiseremodeling.co

# Email (consultation notifications)
# RESEND_API_KEY=

# Address autocomplete (Google Places) — recommended for production
# Without this key, the form falls back to OpenStreetMap Nominatim (Treasure Valley only)
# GOOGLE_MAPS_API_KEY=

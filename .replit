modules = ["nodejs-24", "web", "python-3.11", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["imagemagick", "libwebp"]

[deployment]
deploymentTarget = "autoscale"
build = ["env", "PUBLISHING_BUILD_COPY=1", "bash", "scripts/build-deployment.sh"]
run = ["bash", "start.sh"]

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "PR 46 isolated preview"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash dev-start.sh"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "PR 46 isolated preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "env -i PATH=/nix/store/s7awkfc4pym4zj139fsxrjs5xwf5hhnd-nodejs-24.13.0-wrapped/bin:/usr/bin:/bin HOME=/tmp NODE_ENV=development NEXT_TELEMETRY_DISABLED=1 /nix/store/s7awkfc4pym4zj139fsxrjs5xwf5hhnd-nodejs-24.13.0-wrapped/bin/node --no-experimental-require-module --no-strip-types .local/previews/pr46/serve.cjs"
waitForPort = 5000

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_openai_ai_integrations:1.0.0", "google-mail:1.0.0", "stripe:1.0.0", "javascript_log_in_with_replit:1.0.0", "resend:1.0.0", "javascript_stripe:1.0.0"]

[userenv]

[userenv.shared]
ADMIN_EMAILS = "webiq.co@gmail.com,info@webiq.co,hello@boisecabinet.co,hello@boiseremodeling.co,hello@p5homeco.com,hello@boiseconstruction.co"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY = "pk_live_51LGm9XKmgtIDVx8lrH27gaoWAdwf1F0O7Gxx2RkNqICfBvPslxV7IJCdufiFDHnNxaCKgr3IcOZokNdmNaxy3z6z000ipOzjOv"
NODE_OPTIONS = "--max-old-space-size=1536"
NEXT_PUBLIC_GA_MEASUREMENT_ID = "G-VTVTQZ8JCD"
NEXT_PUBLIC_META_PIXEL_ID = "925837669911613"

[userenv.production]
P5_SCOPE_OPENAI_MODEL = "gpt-5.6-sol"
P5_OBJECT_STORAGE_ENABLED = "true"

[userenv.development]
P5_OBJECT_STORAGE_ENABLED = "true"
P5_SCOPE_OPENAI_MODEL = "gpt-5.6-sol"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-9747a152-7a58-44e0-a22e-b3ecaa1df8d5"
